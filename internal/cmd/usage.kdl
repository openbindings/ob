min_usage_version "2.0.0"
name "ob"
bin "ob"
about "OpenBindings CLI"

cmd "init" help="Initialize an OpenBindings environment (.openbindings/)" opKey="initializeEnvironment" {
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
}

cmd "environment" help="Show the active OpenBindings environment" opKey="reportEnvironmentStatus" {
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
}

cmd "status" help="Report an OBI's drift against its sources (read-only)" opKey="reportInterfaceStatus" {
  flag "--exit-code" help="Exit non-zero if any source has drift (CI gate)"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<obi-path>" help="Path to the OBI file"
}

cmd "resolve" help="Resolve an OpenBindings interface from a URL or host" opKey="resolveInterface" {
  flag "-o --output <path>" help="Write output to file (default: derived from host)"
  arg "<url-or-host>" help="Base URL or host (e.g. localhost:8080)"
}

cmd "describe" help="Show ob identity and metadata" opKey="describe" {
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
}

cmd "context" help="Manage binding context (credentials, headers, environment)" subcommand_required=true {
  cmd "list" help="List all contexts" opKey="listContexts" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
  }
  cmd "get" help="Get context details for a target URL (secrets masked)" opKey="getContext" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<url>" help="Target URL"
  }
  cmd "set" help="Set context fields for a target URL" opKey="setContext" {
    flag "--bearer-token <token>" help="Bearer token (- for stdin)"
    flag "--api-key <key>" help="API key (- for stdin)"
    flag "--basic" help="Set basic auth (prompts for username and password)"
    flag "--header <header>" help="Add header as \"Key: Value\" (repeatable)"
    flag "--cookie <cookie>" help="Add cookie as \"Key=Value\" (repeatable)"
    flag "--env <env>" help="Add env var as \"VAR=value\" (repeatable)"
    flag "--meta <meta>" help="Add metadata as \"key=value\" (repeatable)"
    flag "--from-curl <curl>" help="Import context from a curl command string"
    arg "<url>" help="Target URL"
  }
  cmd "remove" help="Remove context for a target URL" opKey="removeContext" {
    arg "<url>" help="Target URL"
  }
}

cmd "delegate" help="Manage delegates" subcommand_required=true {
  cmd "list" help="List delegates" opKey="listDelegates" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
  }
  cmd "add" help="Add a delegate" opKey="addDelegate" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<url>" help="Delegate URL (e.g., exec:my-cli, https://api.example.com)"
  }
  cmd "remove" help="Remove a delegate" opKey="removeDelegate" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<url>" help="Delegate URL"
  }
  cmd "resolve" help="Show which delegate handles a format" opKey="resolveDelegate" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<format-token>" help="Format token to resolve"
  }
  cmd "requirements" help="Print the interface a delegate must satisfy for a capability" opKey="getDelegateRequirements" {
    arg "<capability>" help="Capability: invoke, synthesize, or inspect"
  }
  cmd "prefer" help="Set a delegate's selection preference (higher = more preferred)" opKey="setDelegatePreference" {
    flag "--capability <cap>" help="Scope to a capability: invoke, synthesize, or inspect"
    flag "--source-format <format>" help="Scope to a binding-source format (requires --capability)"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<location>" help="Delegate location"
    arg "<preference>" help="Preference value (higher = more preferred)"
  }
}

cmd "formats" help="List format tokens this ob instance can handle" opKey="listFormats" {
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
}

cmd "new" help="Create an empty OpenBindings interface document" opKey="newInterface" {
  flag "--name <name>" help="Interface name"
  flag "--version <version>" help="Interface version"
  flag "--description <desc>" help="Interface description"
  flag "--openbindings <version>" help="Target OpenBindings spec version (default: latest tested)"
  flag "--force" help="Overwrite an existing file"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<path>" help="Path for the new OBI file"
}

cmd "meta" help="Manage interface-level metadata" subcommand_required=true {
  cmd "set" help="Edit interface metadata (name, version, description)" opKey="setMetadata" {
    flag "--name <name>" help="Set the interface name"
    flag "--version <version>" help="Set the interface version"
    flag "--description <desc>" help="Set the interface description"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
  }
}

cmd "inspect" help="Inspect a binding source and list its bindable targets" opKey="inspectSource" {
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<source>" help="Binding source as [format:]path[?options] (e.g., openapi.json)"
}

cmd "source" help="Manage source references on an OBI" subcommand_required=true {
  cmd "add" help="Register a source reference on an OBI" opKey="addSource" {
    flag "--key <name>" help="Explicit source key (default: derived from format and path)"
    flag "--resolve <mode>" help="Resolution mode: location (default) or content"
    flag "--uri <url>" help="Explicit published URI for location mode"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "<source>" help="Source path or format:path (e.g., openapi.json or usage@2.0.0:./cli.kdl)"
  }
  cmd "pull" help="Derive operations and bindings from registered sources" opKey="pullSource" {
    flag "--pure" help="Strip x-ob metadata from the output (publish-clean); requires -o"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "[source-key]..." help="Sources to pull (default: all)"
  }
  cmd "list" help="List source references on an OBI" opKey="listSources" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
  }
  cmd "remove" help="Remove a source reference from an OBI" opKey="removeSource" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "<key>" help="Source key to remove"
  }
}

cmd "operation" help="Manage and invoke operations on an OBI" subcommand_required=true {
  cmd "add" help="Add a new operation to an OBI" opKey="addOperation" {
    flag "--description <desc>" help="Operation description"
    flag "--alias <alias>" help="Satisfaction alias: another interface's operation key this satisfies (repeatable)"
    flag "--tag <tag>" help="Operation tag (repeatable)"
    flag "--input-schema <schema>" help="Input schema: inline JSON, @file, or - for stdin"
    flag "--output-schema <schema>" help="Output schema: inline JSON, @file, or - for stdin"
    flag "--idempotent <bool>" help="Whether the operation is idempotent (true/false)"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "<key>" help="Key for the new operation"
  }
  cmd "alias" help="Manage an operation's satisfaction aliases" subcommand_required=true {
    cmd "add" help="Add satisfaction alias(es) to an operation" opKey="addOperationAlias" {
      flag "-o --output <path>" help="Write output to file"
      flag "-F --format <format>" help="Output format: json|yaml|text"
      arg "<obi-path>" help="Path to the OBI file"
      arg "<operation>" help="Operation key or identifier"
      arg "<alias>..." help="Satisfaction alias(es) to add"
    }
    cmd "remove" help="Remove satisfaction alias(es) from an operation" opKey="removeOperationAlias" {
      flag "-o --output <path>" help="Write output to file"
      flag "-F --format <format>" help="Output format: json|yaml|text"
      arg "<obi-path>" help="Path to the OBI file"
      arg "<operation>" help="Operation key or identifier"
      arg "<alias>..." help="Satisfaction alias(es) to remove"
    }
    cmd "list" help="Show the satisfaction map (which ops satisfy which interfaces)" opKey="listOperationAliases" {
      flag "-o --output <path>" help="Write output to file"
      flag "-F --format <format>" help="Output format: json|yaml|text"
      arg "<obi-path>" help="Path to the OBI file"
      arg "[operation]" help="Scope to a single operation"
    }
  }
  cmd "set" help="Edit an existing operation" opKey="setOperation" {
    flag "--description <desc>" help="Set the operation description"
    flag "--idempotent <bool>" help="Set whether the operation is idempotent (true/false)"
    flag "--deprecated <bool>" help="Set whether the operation is deprecated (true/false)"
    flag "--input-schema <schema>" help="Set input schema: inline JSON, @file, or - for stdin"
    flag "--output-schema <schema>" help="Set output schema: inline JSON, @file, or - for stdin"
    flag "--add-tag <tag>" help="Add a tag (repeatable)"
    flag "--remove-tag <tag>" help="Remove a tag (repeatable)"
    flag "--own" help="Take ownership of a source-owned operation (detach) before editing"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "<operation>" help="Operation key or identifier"
  }
  cmd "detach" help="Convert a source-owned operation to hand-authored" opKey="detachOperation" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "<operation>" help="Operation key or identifier"
  }
  cmd "codegen-name" help="Set the symbol name 'ob codegen' emits for an operation" opKey="setOperationCodegenName" {
    flag "--clear" help="Remove the codegen-name override"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "<operation>" help="Operation key or identifier"
    arg "[name]" help="New codegen symbol name (omit with --clear)"
  }
  cmd "bind" help="Attach a source ref to an existing operation" opKey="bindOperation" {
    flag "--transform-stub" help="Scaffold identity transform stub(s) on shape mismatch"
    flag "--input-transform <jsonata>" help="Inline JSONata transforming operation input to binding input"
    flag "--output-transform <jsonata>" help="Inline JSONata transforming binding output to operation output"
    flag "--preference <num>" help="Binding selection preference (higher = more preferred)"
    flag "--force" help="Overwrite an existing binding for this operation+source (re-point)"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "[operation]" help="Operation key or identifier"
    arg "[source]" help="Source key"
    arg "[ref]" help="Source ref to bind"
  }
  cmd "unbind" help="Remove a binding from an operation (keep the operation)" opKey="unbindOperation" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "<operation>" help="Operation key or identifier"
    arg "<source>" help="Source key whose binding to remove"
  }
  cmd "invoke" help="Invoke an operation via a binding" opKey="invokeOperation" {
    flag "--binding <key>" help="Binding key to invoke (operation is derived from the entry)"
    flag "--input <json>" help="Operation input as JSON"
    flag "-v --verbose" help="Show binding key and duration on stderr"
    arg "<obi-path>" help="Path to the OBI file"
    arg "[operation]" help="Operation key to invoke"
  }
  cmd "prepare" help="Preflight an operation's required context without invoking it" opKey="prepareOperation" {
    flag "--binding <key>" help="Binding key to preflight (operation is derived from the entry)"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "[operation]" help="Operation key to preflight"
  }
  cmd "list" help="List operations on an OBI" opKey="listOperations" {
    flag "--tag <tag>" help="Filter operations by tag"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
  }
  cmd "rename" help="Rename an operation and update all references" opKey="renameOperation" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "<old-key>" help="Current operation key"
    arg "<new-key>" help="New operation key"
  }
  cmd "remove" help="Remove operations and their bindings from an OBI" opKey="removeOperation" {
    flag "--force" help="Remove managed operations without warning"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file"
    arg "<key>..." help="Operation keys to remove"
  }
}

cmd "binding" help="Low-level binding operations" subcommand_required=true {
  cmd "invoke" help="Invoke a resolved binding (machine-to-machine)" opKey="invokeBinding" {
    flag "--input <json>" help="BindingInvocationInput as a JSON string"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
  }
  cmd "prepare" help="Preflight a resolved binding (machine-to-machine)" opKey="prepareBinding" {
    flag "--input <json>" help="BindingInvocationInput as a JSON string"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
  }
}

cmd "diff" help="Structural comparison of two OBIs" opKey="compareInterfaces" {
  flag "--from-sources" help="Compare against what binding sources produce"
  flag "--only <key>" help="Scope to a specific source key (requires --from-sources)"
  flag "-q --quiet" help="Exit code only, no output"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<baseline>" help="Baseline OBI (file path, URL, or exec: locator)"
  arg "[comparison]" help="Comparison OBI (omit with --from-sources)"
}

cmd "merge" help="Selectively apply changes from one OBI into another" opKey="mergeInterfaces" {
  flag "--from-sources" help="Derive from the target's binding sources"
  flag "--only <key>" help="Scope to a specific source key (requires --from-sources)"
  flag "--all" help="Apply all changes (batch mode)"
  flag "--dry-run" help="Preview changes without writing"
  flag "-y --yes" help="Auto-accept all prompts"
  flag "--out <path>" help="Write to alternate path instead of target"
  flag "--op <key>" help="Only merge this operation (repeatable)"
  flag "--exclude-op <key>" help="Exclude this operation from merge (repeatable)"
  flag "--ops-only" help="Graft operations only (no bindings or source entries) — adopt-keys satisfaction"
  flag "--no-bindings" help="Don't graft bindings (operations and their sources still come)"
  flag "--no-sources" help="Don't graft source entries (operations and bindings still come)"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<target>" help="Target OBI to merge into"
  arg "[source]" help="Source OBI (omit with --from-sources)"
}

cmd "validate" help="Validate an OpenBindings interface document" opKey="validateInterface" {
  flag "-q --quiet" help="Exit code only, no output"
  flag "--strict" help="Reject unknown fields and require supported version"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<locator>" help="File path, HTTP(S) URL, or exec: locator"
}

cmd "compat" help="Check interface conformance between two interfaces" opKey="reportCompatibility" {
  flag "-q --quiet" help="Exit code only, no output"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<target>" help="Target interface (locator)"
  arg "<candidate>" help="Candidate interface (locator)"
}

cmd "conform" help="Scaffold a target OBI so it satisfies a reference interface" opKey="conform" {
  flag "-y --yes" help="Auto-accept all scaffolding and replacements"
  flag "--dry-run" help="Preview changes without modifying files"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<interface>" help="Reference interface to satisfy (locator)"
  arg "<target-obi>" help="Target OBI to scaffold into"
}

cmd "purify" help="Strip x-ob vendor metadata, yielding a spec-only interface" opKey="purifyInterface" {
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<obi-path>" help="Interface to purify"
}

cmd "codegen" help="Generate a typed invoker from an interface" opKey="codegen" {
  flag "-l --lang <language>" help="Target language: typescript or go (required)"
  flag "-o --output <path>" help="Output file path (default: stdout)"
  flag "--package <name>" help="Go package name (default: derived from interface name)"
  arg "<source>" help="Interface to generate from (file path or URL)"
}

cmd "mcp" help="Serve an interface URL as an MCP server" opKey="startMCPServer" {
  flag "--transport <transport>" help="Transport: stdio or http (default: stdio)"
  flag "--port <port>" help="HTTP port (when transport is http, default: 8080)"
  flag "--name <name>" help="MCP server name"
  arg "<url>" help="Interface URL to expose as an MCP server (compose an aggregate OBI for several services)"
}

cmd "start" help="Start a local server exposing ob operations (HTTP, WebSocket, MCP)" opKey="startServer" {
  flag "-p --port <port>" help="Port to listen on (default: 20290 = 0x4F42, ASCII OB)"
  flag "--allow-origin <origin>" help="Allowed CORS origin (repeatable)"
  flag "--token <token>" help="Pre-shared session token (also: OB_START_TOKEN env var)"
  flag "--token-file <path>" help="Write session token to file instead of stderr"
}

cmd "demo" help="Start the OpenBlendings demo server (one interface, six protocols)" opKey="demo" {
  flag "-p --port <port>" help="HTTP server port (default: 8080)"
  flag "--grpc-port <port>" help="gRPC server port (default: 9090)"
}
