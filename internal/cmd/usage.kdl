min_usage_version "2.0.0"
name "ob"
bin "ob"
about "OpenBindings CLI"

cmd "init" help="Initialize an OpenBindings environment (.openbindings/)" {
  flag "--global" help="Initialize the global environment (user config dir)"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
}

cmd "environment" help="Show the active OpenBindings environment" {
  alias "env"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
}

cmd "status" help="Report an OBI's drift against its sources (read-only)" {
  flag "--exit-code" help="Exit non-zero if any source has drift (CI gate)"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<obi-path>" help="Path to the OBI file (- for stdin)"
}

cmd "resolve" help="Resolve an OpenBindings interface from a URL or host" {
  flag "-o --output <path>" help="Write output to file (default: derived from host)"
  flag "-F --format <format>" help="Output format: json|yaml|text (json/yaml prints the resolved interface and its origin to stdout instead of writing a file)"
  arg "<address>" help="Base URL or host (e.g. localhost:8080)"
}

cmd "describe" help="Show ob identity and metadata" {
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
}

cmd "context" help="Manage binding context (credentials, headers, environment)" subcommand_required=true {
  alias "ctx" "contexts"
  cmd "list" help="List all contexts" {
    alias "ls"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
  }
  cmd "get" help="Get context for a target URL (text masks secrets; JSON is the raw payload)" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<url>" help="Target URL"
  }
  cmd "set" help="Set context fields for a target URL" {
    flag "--bearer-token <token>" help="Bearer token (- for stdin)"
    flag "--api-key <key>" help="API key (- for stdin)"
    flag "--basic" help="Set basic auth (prompts for username and password)"
    flag "--header <header>" help="Add header as \"Key: Value\" (repeatable)" var=#true
    flag "--cookie <cookie>" help="Add cookie as \"Key=Value\" (repeatable)" var=#true
    flag "--env <env>" help="Add env var as \"VAR=value\" (repeatable)" var=#true
    flag "--meta <meta>" help="Add metadata as \"key=value\" (repeatable)" var=#true
    flag "--from-curl <curl>" help="Import context from a curl command string"
    flag "--value <json>" help="Full Context value as JSON (machine lane; full replacement, keyed by <url>, exclusive with field flags; - reads stdin)"
    arg "[url]" help="Target URL"
  }
  cmd "remove" help="Remove context for a target URL" {
    alias "rm"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<url>" help="Target URL"
  }
}

cmd "delegate" help="Manage delegates" subcommand_required=true {
  alias "delegates"
  cmd "register" help="Register a delegate" {
    alias "add"
    flag "--preference <num>" help="Initial delegate-level selection preference (higher = more preferred)"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<location>" help="Delegate location (e.g., exec:my-cli, https://api.example.com)"
  }
  cmd "unregister" help="Unregister a delegate" {
    alias "remove" "rm"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<location>" help="Delegate location"
  }
  cmd "list" help="List delegates" {
    alias "ls"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
  }
  cmd "resolve" help="Resolve an operation to the delegates that carry it" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<operation>" help="Operation identifier to resolve"
  }
  cmd "resolve-binding-spec" help="Show which delegate ob's routing would select for a binding specification" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<binding-spec>" help="Binding specification identifier to resolve"
  }
  cmd "requirements" help="Print the interface a delegate must correspond to for a capability" {
    arg "<capability>" help="Capability: invoke, synthesize, or inspect"
  }
  cmd "prefer" help="Set or clear a delegate's selection preference (higher = more preferred)" {
    flag "--operation <op>" help="Scope to one operation identifier"
    flag "--capability <cap>" help="Shorthand for the operation of an ob capability: invoke, synthesize, or inspect"
    flag "--binding-spec <identifier>" help="Scope an operation entry to one binding specification (requires --operation or --capability)"
    flag "--clear" help="Remove the targeted preference entry instead of setting it"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<location>" help="Delegate location"
    arg "[preference]" help="Preference value (omit with --clear)"
  }
}

cmd "binding-specs" help="List the binding specifications this ob instance can handle" {
  alias "binding-spec"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
}

cmd "new" help="Create an empty OpenBindings interface document" {
  flag "--name <name>" help="Interface name"
  flag "--version <version>" help="Interface version"
  flag "--description <desc>" help="Interface description"
  flag "--spec-version <version>" help="Target OpenBindings spec version (default: latest tested)"
  flag "--force" help="Overwrite an existing file"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<path>" help="Path for the new OBI file (- writes the document to stdout)"
}

cmd "meta" help="Manage interface-level metadata" subcommand_required=true {
  cmd "set" help="Edit interface metadata (name, version, description)" {
    flag "--name <name>" help="Set the interface name"
    flag "--version <version>" help="Set the interface version"
    flag "--description <desc>" help="Set the interface description"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
  }
}

cmd "inspect" help="Inspect a binding source and list its bindable targets" {
  flag "--input <json>" help="InspectSourceInput as a JSON string (machine lane; exclusive with <source>)"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "[source]" help="Binding source as [format:]path[?options] (e.g., openapi.json; path - reads the artifact from stdin)"
}

cmd "synthesize" help="Synthesize an interface from binding sources" {
  flag "--name <name>" help="Interface name"
  flag "--version <version>" help="Interface version"
  flag "--description <desc>" help="Interface description"
  flag "--spec-version <version>" help="Target OpenBindings spec version (default: latest tested)"
  flag "--input <json>" help="SynthesizeInterfaceInput as a JSON string (machine lane; exclusive with sources and metadata flags)"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "[source]..." help="Binding sources as [format:]path[?options] (none: empty interface; path - reads the artifact from stdin)"
}

cmd "source" help="Manage source references on an OBI" subcommand_required=true {
  alias "src" "sources"
  cmd "add" help="Register a source reference on an OBI" {
    flag "--input <json>" help="AddSourceInput as a JSON string (machine lane; exclusive with positional arguments and source flags)"
    flag "--key <name>" help="Explicit source key (default: derived from format and path)"
    flag "--resolve <mode>" help="Resolution mode: content (default for local files) or location (default for URLs)"
    flag "--uri <url>" help="Explicit published URI for location mode"
    flag "--delegate <delegate>" help="Delegate to use for this source (skips detection)"
    flag "--description <desc>" help="Human-readable description for this source"
    flag "-y --yes" help="Accept first capable delegate without prompting"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "[obi-path]" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "[source]" help="Source path or bindingSpec:path (e.g., openapi.json or openbindings.usage@1:./cli.kdl)"
  }
  cmd "pull" help="Derive operations and bindings from registered sources" {
    flag "--pure" help="Strip x-ob metadata from the output (publish-clean); requires -o"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "[source-key]..." help="Sources to pull (default: all)"
  }
  cmd "list" help="List source references on an OBI" {
    alias "ls"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- for stdin)"
  }
  cmd "remove" help="Remove a source reference from an OBI" {
    alias "rm"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "<key>" help="Source key to remove"
  }
}

cmd "operation" help="Manage and invoke operations on an OBI" subcommand_required=true {
  alias "op" "operations"
  cmd "add" help="Add a new operation to an OBI" {
    flag "--description <desc>" help="Operation description"
    flag "--alias <alias>" help="Correspondence alias: another interface's operation key this operation also answers to (repeatable)" var=#true
    flag "--tag <tag>" help="Operation tag (repeatable)" var=#true
    flag "--input-schema <schema>" help="Input schema: inline JSON, @file, or - for stdin"
    flag "--output-schema <schema>" help="Output schema: inline JSON, @file, or - for stdin"
    flag "--idempotent <bool>" help="Whether the operation is idempotent (true/false)"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "<key>" help="Key for the new operation"
  }
  cmd "alias" help="Manage an operation's correspondence aliases" subcommand_required=true {
    alias "aliases"
    cmd "add" help="Add correspondence alias(es) to an operation" {
      flag "-o --output <path>" help="Write output to file"
      flag "-F --format <format>" help="Output format: json|yaml|text"
      arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
      arg "<operation>" help="Operation key or identifier"
      arg "<alias>..." help="Correspondence alias(es) to add"
    }
    cmd "remove" help="Remove correspondence alias(es) from an operation" {
      alias "rm"
      flag "-o --output <path>" help="Write output to file"
      flag "-F --format <format>" help="Output format: json|yaml|text"
      arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
      arg "<operation>" help="Operation key or identifier"
      arg "<alias>..." help="Correspondence alias(es) to remove"
    }
    cmd "list" help="Show the correspondence map (which ops correspond to which interfaces)" {
      alias "ls"
      flag "-o --output <path>" help="Write output to file"
      flag "-F --format <format>" help="Output format: json|yaml|text"
      arg "<obi>" help="OBI locator (file path, URL, exec: reference, or - for stdin)"
      arg "[operation]" help="Scope to a single operation"
    }
  }
  cmd "set" help="Edit an existing operation" {
    flag "--description <desc>" help="Set the operation description"
    flag "--idempotent <bool>" help="Set whether the operation is idempotent (true/false)"
    flag "--deprecated <bool>" help="Set whether the operation is deprecated (true/false)"
    flag "--input-schema <schema>" help="Set input schema: inline JSON, @file, or - for stdin"
    flag "--output-schema <schema>" help="Set output schema: inline JSON, @file, or - for stdin"
    flag "--add-tag <tag>" help="Add a tag (repeatable)" var=#true
    flag "--remove-tag <tag>" help="Remove a tag (repeatable)" var=#true
    flag "--own" help="Take ownership of a source-owned operation (detach) before editing"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "<operation>" help="Operation key or identifier"
  }
  cmd "detach" help="Convert a source-owned operation to hand-authored" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "<operation>" help="Operation key or identifier"
  }
  cmd "codegen-name" help="Set the symbol name 'ob codegen' emits for an operation" {
    flag "--clear" help="Remove the codegen-name override"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "<operation>" help="Operation key or identifier"
    arg "[name]" help="New codegen symbol name (omit with --clear)"
  }
  cmd "output-schema" help="Set an operation's output schema when its source can't declare one" {
    flag "--clear" help="Remove the output-schema override"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "<operation>" help="Operation key or identifier"
    arg "[schema]" help="Output schema: inline JSON, @file, or - for stdin (omit with --clear)"
  }
  cmd "bind" help="Attach a source ref to an existing operation" {
    flag "--transform-stub" help="Scaffold identity transform stub(s) on shape mismatch"
    flag "--input-transform <jsonata>" help="Inline JSONata transforming operation input to binding input"
    flag "--output-transform <jsonata>" help="Inline JSONata transforming binding output to operation output"
    flag "--preference <num>" help="Author preference signal (higher = more preferred; does not select automatically)"
    flag "--force" help="Overwrite an existing binding for this operation+source (re-point)"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "[operation]" help="Operation key or identifier"
    arg "[source]" help="Source key"
    arg "[ref]" help="Source ref to bind"
  }
  cmd "unbind" help="Remove a binding from an operation (keep the operation)" {
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    flag "--binding <key>" help="Exact binding key to remove (operation and source are not required)"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "[operation]" help="Operation key or identifier"
    arg "[source]" help="Source key whose binding to remove"
  }
  cmd "invoke" help="Invoke an operation via a binding" {
    flag "--binding <key>" help="Binding key to invoke (operation is derived from the entry)"
    flag "--select-binding <key>" help="Ordered binding choice for this and nested operations (repeatable)" var=#true
    flag "--input <value>" help="Operation input: inline JSON, @file, or - for stdin"
    flag "--configuration <json>" help="Binding-spec configuration object: inline JSON, @file, or - for stdin"
    flag "--decode <lane>" help="Output decode lane: json, text, or none" {
      arg "<lane>"
    }
    flag "--ok-exit <codes>" help="Exit codes classified as success, comma-separated (e.g. 0,1)"
    flag "--route <field=channel>" help="Field routing: field=argv|stdin|stdin-dash|file (repeatable)" var=#true
    flag "--diagnostics" help="Include expert binding and implementation diagnostics"
    flag "-v --verbose" help="Show binding key, duration, and any displaced output-schema overrides on stderr"
    arg "<obi>" help="OBI locator (file path, URL, exec: reference, or - for stdin)"
    arg "[operation]" help="Operation key to invoke"
  }
  cmd "prepare" help="Preflight an operation's required context without invoking it" {
    flag "--binding <key>" help="Binding key to preflight (operation is derived from the entry)"
    flag "--select-binding <key>" help="Ordered binding choice (repeatable)" var=#true
    flag "--configuration <json>" help="Binding-spec configuration object: inline JSON, @file, or - for stdin"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi>" help="OBI locator (file path, URL, exec: reference, or - for stdin)"
    arg "[operation]" help="Operation key to preflight"
  }
  cmd "list" help="List operations on an OBI" {
    alias "ls"
    flag "--tag <tag>" help="Filter operations by tag"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi>" help="OBI locator (file path, URL, exec: reference, or - for stdin)"
  }
  cmd "rename" help="Rename an operation and update all references" {
    alias "mv"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "<old-key>" help="Current operation key"
    arg "<new-key>" help="New operation key"
  }
  cmd "remove" help="Remove operations and their bindings from an OBI" {
    alias "rm"
    flag "--force" help="Remove source-owned operations without warning"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- reads stdin and writes the modified document to stdout)"
    arg "<key>..." help="Operation keys to remove"
  }
}

cmd "binding" help="Low-level binding operations" subcommand_required=true {
  cmd "invoke" help="Invoke a binding directly, below the operation layer" {
    flag "--input <json>" help="Binding input value (with positional args), or a BindingInvocationInput envelope (machine lane)"
    arg "[obi-path]" help="OBI document to resolve the binding from"
    arg "[binding-key]" help="Binding key to invoke (output is exactly what the source returned: decoded, not reshaped by the operation's output transform, and unvalidated)"
  }
  cmd "prepare" help="Preflight a resolved binding (machine-to-machine)" {
    flag "--input <json>" help="BindingInvocationInput as a JSON string"
  }
  cmd "list" help="List the bindings an OBI declares (optionally for one operation)" {
    alias "ls"
    flag "-o --output <path>" help="Write output to file"
    flag "-F --format <format>" help="Output format: json|yaml|text"
    arg "<obi-path>" help="Path to the OBI file (- for stdin)"
    arg "[operation]" help="Filter to bindings of one operation"
  }
}

cmd "diff" help="Structural comparison of two OBIs" {
  flag "--from-sources" help="Compare against what binding sources produce"
  flag "--only <key>" help="Scope to a specific source key (requires --from-sources)"
  flag "-q --quiet" help="Exit code only, no output"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<baseline>" help="Baseline OBI (file path, URL, exec: locator, or - for stdin)"
  arg "[comparison]" help="Comparison OBI (omit with --from-sources)"
}

cmd "merge" help="Selectively apply changes from one OBI into another" {
  flag "--from-sources" help="Derive from the target's binding sources"
  flag "--only <key>" help="Scope to a specific source key (requires --from-sources)"
  flag "--all" help="Apply all changes (batch mode)"
  flag "--dry-run" help="Preview changes without writing"
  flag "-y --yes" help="Auto-accept all prompts"
  flag "--out <path>" help="Write to alternate path instead of target"
  flag "--op <key>" help="Only merge this operation (repeatable)" var=#true
  flag "--exclude-op <key>" help="Exclude this operation from merge (repeatable)" var=#true
  flag "--ops-only" help="Graft operations only (no bindings or source entries)"
  flag "--no-bindings" help="Don't graft bindings (operations and their sources still come)"
  flag "--no-sources" help="Don't graft source entries (operations and bindings still come)"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<target>" help="Target OBI to merge into"
  arg "[source]" help="Source OBI (omit with --from-sources)"
}

cmd "validate" help="Validate an OpenBindings interface document" {
  flag "-q --quiet" help="Exit code only, no output"
  flag "--strict" help="Additionally reject unknown (non-x-) fields"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<locator>" help="File path, HTTP(S) URL, exec: locator, or - for stdin"
}

cmd "compat" help="Check interface conformance between two interfaces" {
  flag "-q --quiet" help="Exit code only, no output"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<target>" help="Target interface (locator, or - for stdin)"
  arg "<candidate>" help="Candidate interface (locator)"
}

cmd "conform" help="Scaffold or update operations so the target corresponds to another interface" {
  flag "-y --yes" help="Auto-accept all scaffolding and replacements"
  flag "--dry-run" help="Preview changes without modifying files"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<interface>" help="Reference interface to correspond to (locator)"
  arg "<target-obi>" help="Target OBI to scaffold into"
}

cmd "purify" help="Strip x-ob vendor metadata, yielding a spec-only interface" {
  flag "--check" help="Check purity without writing: exit 1 and list x-ob locations if anything would be stripped"
  flag "-o --output <path>" help="Write output to file"
  flag "-F --format <format>" help="Output format: json|yaml|text"
  arg "<obi-path>" help="Interface to purify (file path, or - for stdin)"
}

cmd "codegen" help="Generate a typed invoker from an interface" {
  flag "-l --lang <language>" help="Target language: typescript or go (required)"
  flag "-o --output <path>" help="Output file path (default: stdout)"
  flag "--package <name>" help="Go package name (default: derived from interface name)"
  flag "-F --format <format>" help="Output format: text (raw code, default) | json|yaml (CodegenOutput envelope)"
  arg "<source>" help="Interface to generate from (file path, URL, or - for stdin)"
}

cmd "mcp" help="Serve an interface or raw artifact as an MCP server" {
  flag "--transport <transport>" help="Transport: stdio or http (default: stdio)"
  flag "--port <port>" help="HTTP port (when transport is http, default: 8080)"
  flag "--name <name>" help="MCP server name (default: ob-mcp)"
  flag "--token <token>" help="Bearer token for authenticating to target servers (also: OB_TOKEN)"
  flag "--token-file <path>" help="Read Bearer token from file"
  flag "--tool-timeout <duration>" help="Bound on a single bridged tool call (MCP tools are request-scoped; a subscription-style operation cannot complete as a tool)"
  flag "--context <json>" help="Invocation context JSON object or @file (credentials, headers, cookies, extensions)"
  flag "--configuration <json>" help="Binding-spec configuration JSON object or @file"
  flag "--select-binding <binding>" help="Ordered binding choice for this and nested operations (repeatable)" var=#true
  flag "--require-complete-coverage" help="Refuse synthesized raw artifacts unless coverage is exhaustive and fully represented"
  flag "--coverage-report <path>" help="Write synthesis coverage evidence to a JSON file"
  arg "<interface-or-artifact>" help="OBI locator or raw artifact to expose as an MCP server"
}

cmd "start" help="Start a local server exposing ob operations (HTTP, WebSocket)" {
  flag "-p --port <port>" help="Port to listen on (default: 20290 = 0x4F42, ASCII OB)"
  flag "--strict-port" help="Fail instead of falling back to a nearby port when --port is busy"
  flag "--allow-origin <origin>" help="Allowed CORS origin (repeatable)" var=#true
  flag "--token <token>" help="Pre-shared session token (also: OB_START_TOKEN env var)"
  flag "--token-file <path>" help="Write session token to file instead of stderr"
  flag "--tls" help="Also serve HTTPS using a local CA (does not modify system trust)"
  flag "--trust-local-ca" help="Install the local HTTPS CA into system trust (implies --tls; may prompt)"
  flag "--open" help="Open the authenticated workbench in the default browser"
  flag "-v --verbose" help="Show request and invocation logs"
}

cmd "demo" help="Start the OpenBlendings demo server (one interface, six protocols)" {
  flag "-p --port <port>" help="HTTP server port (default: 8080)"
  flag "--grpc-port <port>" help="gRPC server port (default: 9090)"
}
