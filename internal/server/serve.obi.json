{
  "bindings": {
    "createInterface.mcp": {
      "operation": "createInterface",
      "ref": "tools/createInterface",
      "security": "session",
      "source": "mcp"
    },
    "createInterface.openapi": {
      "operation": "createInterface",
      "ref": "#/paths/~1interfaces~1create/post",
      "security": "session",
      "source": "openapi"
    },
    "deleteContext.mcp": {
      "operation": "deleteContext",
      "ref": "tools/deleteContext",
      "security": "session",
      "source": "mcp"
    },
    "deleteContext.openapi": {
      "inputTransform": "{ \"url\": key }",
      "operation": "deleteContext",
      "ref": "#/paths/~1contexts~1{url}/delete",
      "security": "session",
      "source": "openapi"
    },
    "getContext.mcp": {
      "operation": "getContext",
      "ref": "tools/getContext",
      "security": "session",
      "source": "mcp"
    },
    "getContext.openapi": {
      "inputTransform": "{ \"url\": key }",
      "operation": "getContext",
      "ref": "#/paths/~1contexts~1{url}/get",
      "security": "session",
      "source": "openapi"
    },
    "getInfo.mcp": {
      "operation": "getInfo",
      "ref": "tools/getInfo",
      "security": "session",
      "source": "mcp"
    },
    "getInfo.openapi": {
      "operation": "getInfo",
      "ref": "#/paths/~1info/get",
      "security": "session",
      "source": "openapi"
    },
    "inspectSource.openapi": {
      "operation": "inspectSource",
      "ref": "#/paths/~1sources~1inspect/post",
      "security": "session",
      "source": "openapi"
    },
    "invokeBinding.asyncapi": {
      "operation": "invokeBinding",
      "priority": 0,
      "ref": "#/operations/invokeBinding",
      "security": "session",
      "source": "asyncapi"
    },
    "invokeBinding.mcp": {
      "operation": "invokeBinding",
      "ref": "tools/invokeBinding",
      "security": "session",
      "source": "mcp"
    },
    "invokeBinding.openapi": {
      "operation": "invokeBinding",
      "priority": 0,
      "ref": "#/paths/~1bindings~1invoke/post",
      "security": "session",
      "source": "openapi"
    },
    "listContexts.mcp": {
      "operation": "listContexts",
      "ref": "tools/listContexts",
      "security": "session",
      "source": "mcp"
    },
    "listContexts.openapi": {
      "operation": "listContexts",
      "ref": "#/paths/~1contexts/get",
      "security": "session",
      "source": "openapi"
    },
    "listFormats.mcp": {
      "operation": "listFormats",
      "ref": "tools/listFormats",
      "security": "session",
      "source": "mcp"
    },
    "listFormats.openapi": {
      "operation": "listFormats",
      "ref": "#/paths/~1formats/get",
      "security": "session",
      "source": "openapi"
    },
    "readQuickReference.mcp": {
      "operation": "readQuickReference",
      "ref": "resources/openbindings://spec/quick-reference.md",
      "security": "session",
      "source": "mcp"
    },
    "readQuickReference.openapi": {
      "inputTransform": "{ \"name\": 'quick-reference.md' }",
      "operation": "readQuickReference",
      "ref": "#/paths/~1spec~1{name}/get",
      "security": "session",
      "source": "openapi"
    },
    "request.mcp": {
      "operation": "request",
      "ref": "tools/request",
      "security": "session",
      "source": "mcp"
    },
    "request.openapi": {
      "operation": "request",
      "ref": "#/paths/~1http~1request/post",
      "security": "session",
      "source": "openapi"
    },
    "resolveInterface.mcp": {
      "operation": "resolveInterface",
      "ref": "tools/resolveInterface",
      "security": "session",
      "source": "mcp"
    },
    "resolveInterface.openapi": {
      "operation": "resolveInterface",
      "ref": "#/paths/~1resolve/post",
      "security": "session",
      "source": "openapi"
    },
    "setContext.mcp": {
      "operation": "setContext",
      "ref": "tools/setContext",
      "security": "session",
      "source": "mcp"
    },
    "setContext.openapi": {
      "inputTransform": "$merge([{ \"url\": key }, context])",
      "operation": "setContext",
      "ref": "#/paths/~1contexts~1{url}/put",
      "security": "session",
      "source": "openapi"
    }
  },
  "description": "Local OpenBindings service for binding invocation, interface resolution, context management, format discovery, source inspection, and HTTP client capabilities.",
  "name": "OpenBindings Local Service",
  "openbindings": "0.2.0",
  "operations": {
    "createInterface": {
      "description": "Create an OpenBindings interface from binding source artifacts.",
      "input": {
        "$ref": "#/schemas/CreateInterfaceInput"
      },
      "output": {
        "$ref": "#/schemas/OpenBindingsInterface"
      },
      "satisfies": [
        {
          "operation": "createInterface",
          "role": "openbindings.interface-creator"
        }
      ]
    },
    "deleteContext": {
      "description": "Delete the stored context for a key. Deleting an absent key succeeds.",
      "idempotent": true,
      "input": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ],
        "type": "object"
      },
      "satisfies": [
        {
          "operation": "deleteContext",
          "role": "openbindings.context-store"
        }
      ]
    },
    "getContext": {
      "description": "Get the stored context for a key. Returns the unified context payload (credentials, headers, cookies, environment, metadata in a single opaque map), or null when no context exists for the key.",
      "idempotent": true,
      "input": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ],
        "type": "object"
      },
      "output": {
        "oneOf": [
          {
            "$ref": "#/schemas/Context"
          },
          {
            "type": "null"
          }
        ]
      },
      "satisfies": [
        {
          "operation": "getContext",
          "role": "openbindings.context-store"
        }
      ]
    },
    "getInfo": {
      "description": "Return identity and metadata about this host.",
      "idempotent": true,
      "output": {
        "$ref": "#/schemas/SoftwareInfo"
      },
      "satisfies": [
        {
          "operation": "getInfo",
          "role": "openbindings.software-descriptor"
        },
        {
          "operation": "getInfo",
          "role": "openbindings.binding-invoker"
        }
      ]
    },
    "inspectSource": {
      "description": "Inspect a binding source artifact and return bindable targets.",
      "input": {
        "$ref": "#/schemas/InspectSourceInput"
      },
      "output": {
        "$ref": "#/schemas/SourceInspection"
      },
      "satisfies": [
        {
          "operation": "inspectSource",
          "role": "openbindings.source-inspector"
        }
      ]
    },
    "invokeBinding": {
      "description": "Invoke a resolved binding.",
      "input": {
        "$ref": "#/schemas/InvokeBindingInput"
      },
      "output": {
        "$ref": "#/schemas/InvokeBindingOutput"
      },
      "satisfies": [
        {
          "operation": "invokeBinding",
          "role": "openbindings.binding-invoker"
        }
      ]
    },
    "listContexts": {
      "description": "List metadata summaries for all stored contexts (no secret values). Not part of the openbindings.context-store role contract — this is ob's management surface.",
      "idempotent": true,
      "output": {
        "items": {
          "$ref": "#/schemas/ContextSummary"
        },
        "type": "array"
      }
    },
    "listFormats": {
      "description": "List binding formats supported by this host.",
      "idempotent": true,
      "output": {
        "items": {
          "$ref": "#/schemas/FormatInfo"
        },
        "type": "array"
      },
      "satisfies": [
        {
          "operation": "listFormats",
          "role": "openbindings.binding-invoker"
        },
        {
          "operation": "listFormats",
          "role": "openbindings.interface-creator"
        },
        {
          "operation": "listFormats",
          "role": "openbindings.source-inspector"
        }
      ]
    },
    "readQuickReference": {
      "description": "OpenBindings spec quick reference: operations, bindings, sources, common ref formats, transform syntax.",
      "idempotent": true,
      "output": {
        "type": "string"
      }
    },
    "request": {
      "description": "Make an HTTP request and return the complete response.",
      "input": {
        "$ref": "#/schemas/HttpRequestInput"
      },
      "output": {
        "$ref": "#/schemas/HttpResponse"
      },
      "satisfies": [
        {
          "operation": "request",
          "role": "openbindings.http-client"
        }
      ]
    },
    "resolveInterface": {
      "description": "Resolve an OpenBindings interface from a URL.",
      "input": {
        "$ref": "#/schemas/ResolveInterfaceInput"
      },
      "output": {
        "$ref": "#/schemas/ResolveInterfaceOutput"
      }
    },
    "setContext": {
      "description": "Create or replace the context for a key. The supplied context fully replaces any existing context.",
      "idempotent": true,
      "input": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/schemas/Context"
          },
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "context"
        ],
        "type": "object"
      },
      "satisfies": [
        {
          "operation": "setContext",
          "role": "openbindings.context-store"
        }
      ]
    }
  },
  "roles": {
    "openbindings.binding-invoker": "https://openbindings.org/spec/interfaces/openbindings.binding-invoker/0.1.json",
    "openbindings.context-store": "https://openbindings.org/spec/interfaces/openbindings.context-store/0.1.json",
    "openbindings.http-client": "https://openbindings.org/spec/interfaces/openbindings.http-client/0.1.json",
    "openbindings.interface-creator": "https://openbindings.org/spec/interfaces/openbindings.interface-creator/0.1.json",
    "openbindings.software-descriptor": "https://openbindings.org/spec/interfaces/openbindings.software-descriptor/0.1.json",
    "openbindings.source-inspector": "https://openbindings.org/spec/interfaces/openbindings.source-inspector/0.1.json"
  },
  "schemas": {
    "BindableTarget": {
      "additionalProperties": true,
      "properties": {
        "operation": {
          "$ref": "#/schemas/Operation"
        },
        "operationKey": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "BindingContext": {
      "additionalProperties": true,
      "type": "object"
    },
    "Context": {
      "additionalProperties": true,
      "description": "Opaque per-target context payload — credentials, session state, headers, cookies, environment, metadata, or any other invoker-managed state. Well-known fields include 'bearerToken', 'apiKey', 'basic', 'headers', 'cookies', 'environment', 'metadata'.",
      "type": "object"
    },
    "ContextSummary": {
      "description": "Non-secret metadata about a stored context entry. Returned by listContexts; never includes secret values.",
      "properties": {
        "cookieCount": {
          "type": "integer"
        },
        "envCount": {
          "type": "integer"
        },
        "hasCredentials": {
          "type": "boolean"
        },
        "headerCount": {
          "type": "integer"
        },
        "loadError": {
          "type": "string"
        },
        "metadataCount": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "hasCredentials"
      ],
      "type": "object"
    },
    "CreateInterfaceInput": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "openbindingsVersion": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/schemas/CreateInterfaceSource"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "CreateInterfaceSource": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "location"
          ]
        },
        {
          "required": [
            "content"
          ]
        }
      ],
      "properties": {
        "content": {},
        "description": {
          "type": "string"
        },
        "embed": {
          "type": "boolean"
        },
        "format": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "outputLocation": {
          "type": "string"
        }
      },
      "required": [
        "format"
      ],
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "details": {},
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "FormatInfo": {
      "properties": {
        "description": {
          "type": "string"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "token"
      ],
      "type": "object"
    },
    "HttpRequestInput": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "followRedirects": {
          "type": "boolean"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "maxResponseBytes": {
          "type": "integer"
        },
        "method": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "HttpResponse": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "status": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "body"
      ],
      "type": "object"
    },
    "InspectSourceInput": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/schemas/Source"
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "InvokeBindingInput": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/schemas/BindingContext"
        },
        "input": {},
        "ref": {
          "type": "string"
        },
        "source": {
          "$ref": "#/schemas/InvokeSource"
        }
      },
      "required": [
        "source",
        "ref"
      ],
      "type": "object"
    },
    "InvokeBindingOutput": {
      "additionalProperties": true,
      "properties": {
        "durationMs": {
          "type": "number"
        },
        "error": {
          "$ref": "#/schemas/Error"
        },
        "output": {},
        "status": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "InvokeSource": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "location"
          ]
        },
        {
          "required": [
            "content"
          ]
        }
      ],
      "properties": {
        "content": {},
        "format": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      },
      "required": [
        "format"
      ],
      "type": "object"
    },
    "OpenBindingsInterface": {
      "additionalProperties": true,
      "description": "An OpenBindings interface document.",
      "properties": {
        "bindings": {
          "additionalProperties": true,
          "type": "object"
        },
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "openbindings": {
          "type": "string"
        },
        "operations": {
          "additionalProperties": true,
          "type": "object"
        },
        "roles": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "schemas": {
          "additionalProperties": true,
          "type": "object"
        },
        "sources": {
          "additionalProperties": true,
          "type": "object"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "openbindings",
        "operations"
      ],
      "type": "object"
    },
    "Operation": {
      "additionalProperties": true,
      "properties": {
        "deprecated": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "input": {},
        "output": {},
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ResolveInterfaceInput": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "ResolveInterfaceOutput": {
      "additionalProperties": false,
      "properties": {
        "finalUrl": {
          "description": "URL after following any redirects.",
          "type": "string"
        },
        "interface": {
          "$ref": "#/schemas/OpenBindingsInterface"
        },
        "sourceFormat": {
          "description": "Detected binding format token (e.g. \"openapi@3.0.3\") when synthesized. Empty for native OBIs.",
          "type": "string"
        },
        "synthesized": {
          "description": "True when the OBI was created from a raw spec (e.g. OpenAPI) rather than loaded from a published OBI.",
          "type": "boolean"
        },
        "url": {
          "description": "URL the OBI was resolved from (after well-known discovery, before redirects).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "SoftwareInfo": {
      "properties": {
        "description": {
          "type": "string"
        },
        "homepage": {
          "type": "string"
        },
        "maintainer": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "location"
          ]
        },
        {
          "required": [
            "content"
          ]
        }
      ],
      "properties": {
        "content": {},
        "description": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      },
      "required": [
        "format"
      ],
      "type": "object"
    },
    "SourceInspection": {
      "additionalProperties": true,
      "properties": {
        "exhaustive": {
          "type": "boolean"
        },
        "targets": {
          "items": {
            "$ref": "#/schemas/BindableTarget"
          },
          "type": "array"
        }
      },
      "required": [
        "targets",
        "exhaustive"
      ],
      "type": "object"
    }
  },
  "security": {
    "session": [
      {
        "authorizeUrl": "/oauth/authorize",
        "clientId": "openbindings",
        "description": "OAuth2 Authorization Code with PKCE",
        "tokenUrl": "/oauth/token",
        "type": "oauth2"
      },
      {
        "description": "Session token (shown on server startup or via --token flag)",
        "type": "bearer"
      }
    ]
  },
  "sources": {
    "asyncapi": {
      "format": "asyncapi@3.0",
      "location": "./asyncapi.yaml"
    },
    "mcp": {
      "format": "mcp",
      "location": "./mcp"
    },
    "openapi": {
      "format": "openapi@3.1",
      "location": "./openapi.yaml"
    }
  },
  "version": "0.1.0"
}
