{
  "openbindings": "0.2.0",
  "name": "OpenBlendings",
  "version": "1.0.0",
  "description": "A coffee shop demonstrating OpenBindings across REST, Connect, gRPC, MCP, GraphQL, and SSE. One interface, six protocols, zero duplication.",
  "schemas": {
    "MenuResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/MenuItem"
          }
        }
      }
    },
    "MenuItem": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "sizes": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/SizePrice"
          }
        }
      }
    },
    "SizePrice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "price": {
          "type": "number"
        }
      }
    },
    "PlaceOrderInput": {
      "type": "object",
      "properties": {
        "drink": {
          "type": "string",
          "description": "Name of the drink to order",
          "examples": [
            "Schema Latte"
          ]
        },
        "size": {
          "type": "string",
          "description": "Size: v1 (small), v2 (medium), or v3 (large)",
          "enum": [
            "v1",
            "v2",
            "v3"
          ],
          "examples": [
            "v2"
          ]
        },
        "customer": {
          "type": "string",
          "description": "Customer name for the order",
          "examples": [
            "Alice"
          ]
        }
      },
      "required": [
        "drink",
        "size",
        "customer"
      ]
    },
    "PlaceOrderOutput": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "drink": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "customer": {
          "type": "string"
        }
      }
    },
    "GetOrderStatusOutput": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "drink": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "customer": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "CancelOrderOutput": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "OrderUpdate": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "drink": {
          "type": "string"
        },
        "customer": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "operations": {
    "getMenu": {
      "description": "Get the OpenBlendings menu with drinks, sizes, and prices.",
      "idempotent": true,
      "output": {
        "$ref": "#/schemas/MenuResponse"
      },
      "tags": [
        "menu"
      ]
    },
    "placeOrder": {
      "description": "Place a new coffee order.",
      "input": {
        "$ref": "#/schemas/PlaceOrderInput"
      },
      "output": {
        "$ref": "#/schemas/PlaceOrderOutput"
      },
      "tags": [
        "orders"
      ]
    },
    "getOrderStatus": {
      "description": "Check the current status of an order.",
      "idempotent": true,
      "input": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "The order ID to check"
          }
        },
        "required": [
          "orderId"
        ]
      },
      "output": {
        "$ref": "#/schemas/GetOrderStatusOutput"
      },
      "tags": [
        "orders"
      ]
    },
    "cancelOrder": {
      "description": "Cancel a pending or preparing order.",
      "input": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "The order ID to cancel"
          }
        },
        "required": [
          "orderId"
        ]
      },
      "output": {
        "$ref": "#/schemas/CancelOrderOutput"
      },
      "tags": [
        "orders"
      ]
    },
    "orderUpdates": {
      "description": "Real-time stream of order status changes (received, preparing, ready, picked_up, cancelled).",
      "output": {
        "$ref": "#/schemas/OrderUpdate"
      },
      "tags": [
        "orders",
        "realtime"
      ]
    },
    "placeAndTrack": {
      "description": "Place a coffee order and track it in real time until it's ready. Combines placeOrder with the orderUpdates stream, filtering for the placed order's status changes. Returns when the order reaches 'ready' or 'picked_up'.",
      "input": {
        "$ref": "#/schemas/PlaceOrderInput"
      },
      "output": {
        "$ref": "#/schemas/OrderUpdate"
      },
      "tags": [
        "orders",
        "realtime",
        "graph"
      ]
    }
  },
  "sources": {
    "restApi": {
      "bindingSpec": "openbindings.openapi-3.1@1",
      "location": "http://localhost:8080/openapi.json",
      "description": "REST API \u2014 the mobile ordering app calls this"
    },
    "mcpServer": {
      "bindingSpec": "openbindings.mcp@1",
      "location": "http://localhost:8080/mcp",
      "description": "MCP tools via Streamable HTTP \u2014 AI assistants use this"
    },
    "grpcServer": {
      "bindingSpec": "openbindings.grpc@1",
      "location": "grpc://localhost:9090",
      "description": "gRPC service \u2014 backend microservices talk over this"
    },
    "connectServer": {
      "bindingSpec": "openbindings.connect@1",
      "location": "http://localhost:8080",
      "description": "Connect (Buf) \u2014 same protobuf service over HTTP/1.1 + JSON"
    },
    "graphqlServer": {
      "bindingSpec": "openbindings.graphql@1",
      "location": "http://localhost:8080/graphql",
      "description": "GraphQL API \u2014 flexible queries with field selection"
    },
    "placeAndTrackGraph": {
      "bindingSpec": "openbindings.operation-graph@1",
      "description": "Operation graph \u2014 places an order and tracks it via a selected live update stream until ready",
      "content": {
        "graphs": {
          "placeAndTrack": {
            "openbindings.operation-graph": "0.2.0",
            "description": "Place a coffee order, subscribe to live updates, and return when the order is ready.",
            "nodes": {
              "in": {
                "type": "input"
              },
              "place": {
                "type": "operation",
                "operation": "placeOrder"
              },
              "subscribe": {
                "type": "operation",
                "operation": "orderUpdates"
              },
              "combined": {
                "type": "combine"
              },
              "match": {
                "type": "filter",
                "transform": "place != null and subscribe != null and subscribe.orderId = place.orderId and subscribe.status in ['ready', 'picked_up']"
              },
              "shape": {
                "type": "transform",
                "transform": "subscribe"
              },
              "done": {
                "type": "exit",
                "onError": "out"
              },
              "out": {
                "type": "output"
              }
            },
            "edges": [
              {
                "from": "in",
                "to": "place"
              },
              {
                "from": "in",
                "to": "subscribe"
              },
              {
                "from": "place",
                "to": "out"
              },
              {
                "from": "place",
                "to": "combined"
              },
              {
                "from": "subscribe",
                "to": "combined"
              },
              {
                "from": "combined",
                "to": "match"
              },
              {
                "from": "match",
                "to": "shape"
              },
              {
                "from": "shape",
                "to": "done"
              }
            ]
          }
        }
      }
    }
  },
  "bindings": {
    "getMenu.restApi": {
      "operation": "getMenu",
      "source": "restApi",
      "selector": "#/paths/~1api~1menu/get",
      "preference": 30
    },
    "getMenu.mcpServer": {
      "operation": "getMenu",
      "source": "mcpServer",
      "selector": "tools/getMenu",
      "preference": 20
    },
    "getMenu.grpcServer": {
      "operation": "getMenu",
      "source": "grpcServer",
      "selector": "blend.CoffeeShop/GetMenu",
      "preference": 10
    },
    "placeOrder.restApi": {
      "operation": "placeOrder",
      "source": "restApi",
      "selector": "#/paths/~1api~1orders/post",
      "inputTransform": "($parameters := {}; $bodyObject := $merge([$sift($,function($value,$key){$key != \"customer\" and $key != \"drink\" and $key != \"size\"}),{\"customer\":$lookup($,\"customer\"),\"drink\":$lookup($,\"drink\"),\"size\":$lookup($,\"size\")}]); {\"parameters\":$count($keys($parameters)) > 0 ? $parameters : $lookup({},\"__openbindings_absent\"),\"body\":($exists($lookup($,\"customer\")) or $exists($lookup($,\"drink\")) or $exists($lookup($,\"size\")) or $count($keys($sift($,function($value,$key){$key != \"customer\" and $key != \"drink\" and $key != \"size\"}))) > 0 or true) ? $bodyObject : $lookup({},\"__openbindings_absent\")})",
      "preference": 30
    },
    "placeOrder.mcpServer": {
      "operation": "placeOrder",
      "source": "mcpServer",
      "selector": "tools/placeOrder",
      "preference": 20
    },
    "placeOrder.grpcServer": {
      "operation": "placeOrder",
      "source": "grpcServer",
      "selector": "blend.CoffeeShop/PlaceOrder",
      "preference": 10
    },
    "getOrderStatus.restApi": {
      "operation": "getOrderStatus",
      "source": "restApi",
      "selector": "#/paths/~1api~1orders~1{orderId}/get",
      "inputTransform": "($parameters := {\"orderId\":$lookup($,\"orderId\")}; $bodyObject := {}; {\"parameters\":$count($keys($parameters)) > 0 ? $parameters : $lookup({},\"__openbindings_absent\"),\"body\":$lookup({},\"__openbindings_absent\")})",
      "preference": 30
    },
    "getOrderStatus.mcpServer": {
      "operation": "getOrderStatus",
      "source": "mcpServer",
      "selector": "tools/getOrderStatus",
      "preference": 20
    },
    "getOrderStatus.grpcServer": {
      "operation": "getOrderStatus",
      "source": "grpcServer",
      "selector": "blend.CoffeeShop/GetOrderStatus",
      "preference": 10
    },
    "cancelOrder.restApi": {
      "operation": "cancelOrder",
      "source": "restApi",
      "selector": "#/paths/~1api~1orders~1{orderId}~1cancel/post",
      "inputTransform": "($parameters := {\"orderId\":$lookup($,\"orderId\")}; $bodyObject := {}; {\"parameters\":$count($keys($parameters)) > 0 ? $parameters : $lookup({},\"__openbindings_absent\"),\"body\":$lookup({},\"__openbindings_absent\")})",
      "preference": 30
    },
    "cancelOrder.mcpServer": {
      "operation": "cancelOrder",
      "source": "mcpServer",
      "selector": "tools/cancelOrder",
      "preference": 20
    },
    "cancelOrder.grpcServer": {
      "operation": "cancelOrder",
      "source": "grpcServer",
      "selector": "blend.CoffeeShop/CancelOrder",
      "preference": 10
    },
    "getMenu.connectServer": {
      "operation": "getMenu",
      "source": "connectServer",
      "selector": "blend.CoffeeShop/GetMenu",
      "inputTransform": "{}",
      "preference": 5
    },
    "placeOrder.connectServer": {
      "operation": "placeOrder",
      "source": "connectServer",
      "selector": "blend.CoffeeShop/PlaceOrder",
      "preference": 5
    },
    "getOrderStatus.connectServer": {
      "operation": "getOrderStatus",
      "source": "connectServer",
      "selector": "blend.CoffeeShop/GetOrderStatus",
      "preference": 5
    },
    "cancelOrder.connectServer": {
      "operation": "cancelOrder",
      "source": "connectServer",
      "selector": "blend.CoffeeShop/CancelOrder",
      "preference": 5
    },
    "getMenu.graphqlServer": {
      "operation": "getMenu",
      "source": "graphqlServer",
      "selector": "query/getMenu",
      "preference": 1
    },
    "placeOrder.graphqlServer": {
      "operation": "placeOrder",
      "source": "graphqlServer",
      "selector": "mutation/placeOrder",
      "preference": 1
    },
    "getOrderStatus.graphqlServer": {
      "operation": "getOrderStatus",
      "source": "graphqlServer",
      "selector": "mutation/getOrderStatus",
      "preference": 1
    },
    "cancelOrder.graphqlServer": {
      "operation": "cancelOrder",
      "source": "graphqlServer",
      "selector": "mutation/cancelOrder",
      "preference": 1
    },
    "orderUpdates.grpcServer": {
      "operation": "orderUpdates",
      "source": "grpcServer",
      "selector": "blend.CoffeeShop/OrderUpdates",
      "preference": 10
    },
    "placeAndTrack.graph": {
      "operation": "placeAndTrack",
      "source": "placeAndTrackGraph",
      "selector": "#/graphs/placeAndTrack",
      "description": "Composed operation: places an order and tracks it via live event stream"
    }
  }
}
