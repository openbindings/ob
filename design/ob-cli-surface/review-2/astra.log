Flags:
      --add-alias stringArray      add an alias (repeatable)
      --add-tag stringArray        add a tag (repeatable)
      --deprecated                 mark deprecated; --deprecated=false marks it current
      --description string         what the operation does
      --dry-run                    show the change without writing it
  -h, --help                       help for set
      --input-schema string        schema for each input value: JSON, @file, or -
      --output-schema string       schema for each output value: JSON, @file, or -
      --remove-alias stringArray   remove an alias (repeatable)
      --remove-tag stringArray     remove a tag (repeatable)
      --unset stringArray          remove a member: description, deprecated, tags, aliases, input, output, examples


